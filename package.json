{
  "name": "aka-browser",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "release:check": "bash scripts/release-check.sh"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": "5.0.12",
      "ajv": "6.14.0",
      "js-yaml": "4.3.2",
      "lodash": "4.18.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.6": "9.0.9",
      "minimatch@>=10.0.0 <10.2.1": "10.2.5",
      "@xmldom/xmldom": "0.8.15",
      "picomatch": "4.0.4",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "http-cache-semantics": "4.3.0",
      "shell-quote@<1.9.0": "1.9.0",
      "tar@<7.5.21": "7.5.21",
      "tmp@<0.2.6": "0.2.6",
      "form-data@<4.0.6": "4.0.6",
      "undici@>=6.0.0 <6.28.1": "6.28.1"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
